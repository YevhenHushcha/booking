<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <groupId>io.github.coworking</groupId>
    <artifactId>coworking-gateway</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>coworking-gateway</name>
    <description>API Gateway sample: routing, JWT, resilience and observability over three services</description>

    <modules>
        <module>common-jwt</module>
        <module>common-observability</module>
        <module>common-problem</module>
        <module>gateway</module>
        <module>user-service</module>
        <module>workspace-service</module>
        <module>booking-service</module>
        <module>e2e-tests</module>
    </modules>

    <properties>
        <java.version>1.8</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- The last release train for Boot 2.7. -->
        <spring-cloud.version>2021.0.9</spring-cloud.version>
        <!-- Boot 2.7 does not manage Testcontainers. 1.21 is the newest line that still runs on Java 8,
             and the oldest that talks to Docker Engine 25+ (older docker-java asks for an API version
             the daemon refuses). -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <!-- WireMock 3 needs Java 11; 2.35 is the last line built for Java 8. -->
        <wiremock.version>2.35.2</wiremock.version>
        <!-- Log4j 1.x: end of life since 2015, with unfixed CVEs (CVE-2019-17571, CVE-2021-4104,
             CVE-2022-23302/23305/23307). Boot dropped support for it in 1.4 and does not manage it. -->
        <log4j.version>1.2.17</log4j.version>
        <!-- Neither is managed by Boot 2.7. Nimbus is kept equal to what spring-security-oauth2-jose 5.7.x
             brings to the gateway, so the issuer and the verifier parse tokens with the same code. -->
        <nimbus-jose-jwt.version>9.22</nimbus-jose-jwt.version>
        <datasource-proxy.version>1.8.1</datasource-proxy.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.nimbusds</groupId>
                <artifactId>nimbus-jose-jwt</artifactId>
                <version>${nimbus-jose-jwt.version}</version>
            </dependency>
            <dependency>
                <groupId>net.ttddyy</groupId>
                <artifactId>datasource-proxy</artifactId>
                <version>${datasource-proxy.version}</version>
            </dependency>
            <dependency>
                <groupId>log4j</groupId>
                <artifactId>log4j</artifactId>
                <version>${log4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.coworking</groupId>
                <artifactId>common-jwt</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.coworking</groupId>
                <artifactId>common-observability</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.coworking</groupId>
                <artifactId>common-problem</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- From 1.7.33 on, slf4j-log4j12 is only a relocation to slf4j-reload4j, which brings
                 the reload4j fork instead of Log4j. 1.7.32 is the last binding to Log4j 1.2 itself. -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-log4j12</artifactId>
                <version>1.7.32</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!-- Building with a newer JDK (as in the IDE): compile against the Java 8 API, not only for
             Java 8 bytecode. With -source/-target alone, a call to List.of() still compiles and then
             fails on a real Java 8 runtime with NoSuchMethodError. javac 8 has no -release flag,
             hence the profile. -->
        <profile>
            <id>release-8-on-newer-jdk</id>
            <activation>
                <jdk>[9,)</jdk>
            </activation>
            <properties>
                <maven.compiler.release>8</maven.compiler.release>
            </properties>
        </profile>
    </profiles>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
