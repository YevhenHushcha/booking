# Copy to .env before the first `docker compose up`.
# .env is git-ignored: no secret, not even a development one, belongs in the repository.

# Superuser of the Postgres container, used only by the init script.
POSTGRES_PASSWORD=change-me-postgres

# Password shared by the three per-service roles (users_app, workspaces_app, bookings_app).
DB_PASSWORD=change-me-app
